    <select id="userTeams" resultType="com.github.pdaodao.springwebplus.entity.SysTeam">
        select t.*, u.nickname as creator_nickname
        from sys_team t
        inner join sys_team_user  tu on t.id = tu.team_id
        left join sys_user u on tu.user_id = u.id
        <where>
            t.is_deleted = 0 and tu.user_id = #{userId}
            <if test="permissionNamespace != null and permissionNamespace !=''">
                and EXISTS (select 1 from sys_team_user_permission p where p.team_user_id = tu.id and namespace=#{permissionNamespace} )
            </if>
        </where>
    </select>
</mapper>